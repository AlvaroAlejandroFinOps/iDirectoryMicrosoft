model Model
	compatibilityLevel: 1604
	culture: es-CL
	directLakeBehavior: directLakeOnly

table fact_costos_obra
	lineageTag: 00000000-0000-0000-0000-000000000041
	source = DirectLake.Table("lakehouse_gold", "fact_costos_obra")

	measure 'Total Costo UF' = SUM('fact_costos_obra'[monto_uf])
		formatString: #,##0.00 "UF"

	measure 'Total Costo Pesos' = SUM('fact_costos_obra'[monto_pesos])
		formatString: "$ #,##0"

