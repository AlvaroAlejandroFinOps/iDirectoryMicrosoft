{
  "instancePool": {
    "name": "StarterPool",
    "type": "CapacityPool",
    "nodeCount": 1,
    "maxNodeCount": 2,
    "autoScale": {
      "enabled": true,
      "minNodeCount": 1,
      "maxNodeCount": 2
    },
    "autoPause": {
      "enabled": true,
      "delayInMinutes": 2
    }
  },
  "sparkProperties": {
    "spark.sql.parquet.vorder.enabled": "true",
    "spark.ms.autotune.optimizeWrite": "true",
    "spark.sql.shuffle.partitions": "8",
    "spark.fabric.capacity.sku": "F8"
  }
}

